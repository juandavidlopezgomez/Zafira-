# ─── App ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# En Hostinger pon la URL de tu dominio (sin barra final)
FRONTEND_URL=https://tudominio.com

# ─── MySQL (Hostinger: Panel → Bases de datos → MySQL) ──────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=tuusuario_db
DB_PASSWORD=tu_password_db
DB_DATABASE=tuusuario_battleflirt

# ─── JWT ────────────────────────────────────────────────────────
# Genera una clave segura: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_segura_de_minimo_32_caracteres
JWT_REFRESH_SECRET=cambia_esto_tambien_por_otra_clave_segura_32chars
JWT_EXPIRES_IN=7d

# ─── Stripe ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# ─── OpenAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Llamas ─────────────────────────────────────────────────────
LLAMAS_INITIAL_BALANCE=100
